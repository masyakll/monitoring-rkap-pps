# Kata sandi demo opsional. Jika dikosongkan, server membuat kata sandi acak dan mencetaknya sekali di terminal.
DEMO_PASSWORD_EKA= chart
DEMO_PASSWORD_AZWIL= hart
DEMO_PASSWORD_IRFAN= hart
DEMO_PASSWORD_OBED= hart
DEMO_PASSWORD_MENTOR= hart
DEMO_PASSWORD_ADMIN= hart

# Sumber data: dummy atau google-sheets. Mode Google Sheets hanya-baca.
DATA_SOURCE=dummy

# Integrasi Google Sheets read-only (server-side). Jangan commit file kredensial.
# Simpan key JSON di luar folder repo, lalu isi path file di bawah.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Alternatif jika lingkungan deployment tidak mendukung path file; base64 bukan enkripsi.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# ID saja (bagian di antara /spreadsheets/d/ dan /edit), bukan URL lengkap.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Row pertama range monitoring harus merupakan kode kolom A1, A2, ... A110 (baris kode pada file monitoring lama).
MONITORING_SHEET_RANGE="'Monitor Investasi2026'!A7:DF5000"
# Idealnya tab penyerapan dibuat pada spreadsheet yang sama agar cukup satu pemberian akses.
# Jika sheet berada pada spreadsheet lain, isi ID di bawah dan berikan akses baca yang disetujui.
ABSORPTION_SPREADSHEET_ID=
ABSORPTION_SHEET_RANGE="'Penyerapan RKAP'!A1:Z5000"
# Ambang perhatian untuk pekerjaan tanpa pembaruan progres; ini indikator monitoring, bukan SLA resmi.
PROGRESS_ATTENTION_DAYS=30
# Kurs IDR per USD; default RKAP 2026 dari referensi adalah 16.300.
USD_IDR_RATE=16300
SCS_HPS_LIMIT_USD=1000
SESSION_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
ORIGIN=
# Placeholder integrasi mendatang; jangan isi rahasia sebelum disetujui IT.
IPRO_API_URL=
IPRO_API_TOKEN=
SAP_API_URL=
SAP_API_USER=
SAP_API_PASSWORD=
DATA_DIR=
